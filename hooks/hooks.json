{
  "description": "Maintain code-anchored memory during Codex turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VIRTUAL_ENV= UV_CACHE_DIR=\"$PLUGIN_DATA/.venv/.uv-cache\" UV_PROJECT_ENVIRONMENT=\"$PLUGIN_DATA/.venv\" PYTHONPATH=\"$PLUGIN_ROOT/src\" uv run --quiet --project \"$PLUGIN_ROOT\" --frozen --no-sync python \"$PLUGIN_ROOT/hooks/user_prompt_submit.py\"",
            "timeout": 10,
            "statusMessage": "Loading active project memory",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "VIRTUAL_ENV= UV_CACHE_DIR=\"$PLUGIN_DATA/.venv/.uv-cache\" UV_PROJECT_ENVIRONMENT=\"$PLUGIN_DATA/.venv\" PYTHONPATH=\"$PLUGIN_ROOT/src\" uv run --quiet --project \"$PLUGIN_ROOT\" --frozen --no-sync python \"$PLUGIN_ROOT/hooks/post_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Recording workspace changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VIRTUAL_ENV= UV_CACHE_DIR=\"$PLUGIN_DATA/.venv/.uv-cache\" UV_PROJECT_ENVIRONMENT=\"$PLUGIN_DATA/.venv\" PYTHONPATH=\"$PLUGIN_ROOT/src\" uv run --quiet --project \"$PLUGIN_ROOT\" --frozen --no-sync python \"$PLUGIN_ROOT/hooks/stop.py\"",
            "timeout": 30,
            "statusMessage": "Reconciling project memory"
          }
        ]
      }
    ]
  }
}
